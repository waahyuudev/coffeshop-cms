!.vscode/settings.json
!.vscode/*.code-snippets
!.vscode/tours
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.yarn

# iconify dist files
resources/js/plugins/iconify/icons.css

# Ignore MSW script
public/mockServiceWorker.js

# Env files - This is the correct way to ignore all .env files except the example
.env*
!.env.example
