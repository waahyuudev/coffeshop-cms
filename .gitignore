# CACHE & SENSITIVE FILES (Keep these ignored)
/.phpunit.cache
/public/hot
/public/storage
/storage/*.key
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea

# LOGS (Keep these ignored)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# NODE MODULES (Definitely keep this ignored)
/node_modules

# VENDOR & BUILD ASSETS (These were the problem)
# You need to commit these folders for a direct Git deployment.
# /public/build
# /vendor

# Editor directories and files
.vscode/*
